#!/usr/bin/env bash
# Гейт перед пушем: профілі гейта проєкту `docs` (правила й імпорт CLAUDE.md, хук
# блокування небезпечних команд агента, whitespace) і `audit` (вразливі
# залежності high і critical). Провал зупиняє пуш; обхід `git push --no-verify`
# агенту заборонений (AGENTS.md).
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

# stdin хука (refs, що пушаться) гейту не потрібен.
cat >/dev/null

PRE_PUSH_PROFILES=(docs audit)
for profile in "${PRE_PUSH_PROFILES[@]}"; do
    bash scripts/agent-check.sh "$profile" </dev/null || {
        printf '\npre-push: ПРОВАЛ гейта %s — пуш зупинено. Полагодь і повтори пуш.\n' "$profile" >&2
        exit 1
    }
done
