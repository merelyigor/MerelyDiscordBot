node_modules/
dist/
.env
coverage/
*.log

# JetBrains: track shared settings, ignore user-specific
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
.idea/datasources.xml
.idea/datasources/

# Артефакти graphify у Git не тримаємо взагалі (рішення власника 2026-09-12):
# граф і звіт відтворюються командою, а post-commit хук перебудовує звіт після
# кожного коміта. Два рядки обовʼязкові: патерн зі слешем усередині діє лише від
# кореня, а кеш лежить і у вкладених теках.
**/.graphify/
/.graphify/

# Data source для IDE: структура підключення (хост, порт, база, користувач) є
# спільною для всіх, хто працює з проєктом, тому вона у Git. Credentials JetBrains
# тримає окремо в .idea/dataSources.local.xml · цей файл лишається ігнорованим.
!/.idea/
/.idea/*
!/.idea/dataSources.xml
