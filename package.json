{
  "name": "merely-discord-bot",
  "version": "0.1.0",
  "description": "Open-source Discord bot running in merely-server-infra.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/data dist/data",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "mysql2": "3.14.3"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "24.2.1",
    "eslint": "9.33.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1"
  }
}
